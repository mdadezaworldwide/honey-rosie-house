{%- comment -%}
  Featured product hero with thumbnail swapping.
  Products are picked from a featured collection (defaults to "frontpage").
{%- endcomment -%}

{%- assign featured_collection = collections[section.settings.collection] -%}
{%- assign featured_products = featured_collection.products | slice: 0, 4 -%}
{%- assign first = featured_products[0] -%}

{%- if first != blank -%}
  <div class="hero-wrap">
    <div class="hero-main" id="heroMain">
      <div class="hero-main__sizer"></div>
      <img class="hero-main__img behind" id="heroImgBehind"
        src="{{ first.featured_image | image_url: width: 1200 }}"
        alt="{{ first.title }}">
      <img class="hero-main__img front" id="heroImgFront"
        src="{{ first.featured_image | image_url: width: 1200 }}"
        alt="{{ first.title }}">
      <div class="hero-main__info">
        <span class="hero-main__name" id="heroMainName">{{ first.title }}</span>
        <span class="hero-main__price" id="heroMainPrice">{{ first.price | money_without_trailing_zeros }}</span>
      </div>
    </div>
    <div class="hero-thumbs" id="heroThumbs">
      {%- for product in featured_products -%}
        <img
          class="hero-thumb {% if forloop.first %}active{% endif %}"
          loading="lazy"
          src="{{ product.featured_image | image_url: width: 300 }}"
          alt="{{ product.title }}"
          data-product="{{ product.handle }}"
          data-name="{{ product.title | escape }}"
          data-price="{{ product.price | money_without_trailing_zeros }}"
          data-href="{{ product.url }}"
        >
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero featured product",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection",
      "info": "Up to 4 products will be displayed"
    }
  ],
  "presets": [
    {
      "name": "Hero featured product"
    }
  ]
}
{% endschema %}
