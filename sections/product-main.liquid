{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="pd-breadcrumb">
  <a href="/">HOME</a>&ensp;/&ensp;
  <a href="/collections/all">ITEMS</a>&ensp;/&ensp;
  {{ product.title }}
</div>

<div class="pd-grid">
  <!-- Left: Images -->
  <div>
    <div class="pd-main-img" id="pd-main-img">
      {%- if product.featured_image -%}
        <img
          class="pd-img-fill"
          src="{{ product.featured_image | image_url: width: 1000 }}"
          alt="{{ product.featured_image.alt | default: product.title }}"
          id="pd-main-img-el"
        >
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="pd-thumbs">
        {%- for image in product.images limit: 4 -%}
          <div class="pd-thumb {% if forloop.first %}active{% endif %}" data-img="{{ image | image_url: width: 1000 }}">
            <img class="pd-thumb-fill" src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title }}">
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Right: Info -->
  <div class="pd-info">
    <h1 class="pd-info__name">{{ product.title }}</h1>
    <div class="pd-info__price" id="pd-price">{{ current_variant.price | money_without_trailing_zeros }}</div>
    <div class="pd-info__tax">税込</div>

    {%- form 'product', product -%}
      <input type="hidden" name="id" id="pd-variant-id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" value="1">

      {%- if product.options.size > 0 -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name_lower = option.name | downcase -%}

          {%- if option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'カラー' or option_name_lower == '色' -%}
            <div class="pd-info__label">カラー</div>
            <div class="pd-colors" data-option-index="{{ forloop.index0 }}">
              {%- for value in option.values -%}
                {%- assign color_slug = value | handleize -%}
                <div
                  class="pd-color-swatch {% if option.selected_value == value %}active{% endif %}"
                  data-value="{{ value }}"
                  style="background: {{ color_slug }};"
                  title="{{ value }}"
                ></div>
              {%- endfor -%}
            </div>

          {%- elsif option_name_lower == 'size' or option_name_lower == 'サイズ' -%}
            <div class="pd-info__label">サイズ</div>
            <div class="pd-sizes" data-option-index="{{ forloop.index0 }}">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="pd-size-pill {% if option.selected_value == value %}active{% endif %}"
                  data-value="{{ value }}"
                >{{ value }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 5 and current_variant.inventory_quantity > 0 -%}
        <div class="pd-stock">残りわずか — お早めにどうぞ</div>
      {%- endif -%}

      <button
        type="submit"
        class="pd-add-btn"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {%- if current_variant.available -%}
          カートに追加
        {%- else -%}
          SOLD OUT
        {%- endif -%}
      </button>
    {%- endform -%}

    <div class="pd-share">
      <span class="pd-share__label">SHARE</span>
      <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}" class="pd-share__btn" target="_blank" rel="noopener" title="X">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="https://social-plugins.line.me/lineit/share?url={{ shop.url }}{{ product.url }}" class="pd-share__btn" target="_blank" rel="noopener" title="LINE">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.58 2 10c0 3.72 3.11 6.85 7.32 7.76.28.06.67.19.77.43.09.22.06.56.03.78l-.12.75c-.04.22-.18.86.76.47.93-.39 5.02-2.96 6.85-5.06C18.94 13.76 20 11.98 20 10c0-4.42-4.48-8-8-8z"/></svg>
      </a>
      <button type="button" class="pd-share__btn" id="share-copy" title="リンクをコピー" data-share-url="{{ shop.url }}{{ product.url }}" style="cursor:pointer;background:transparent;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
    </div>

    {%- if product.description != blank -%}
      <div class="pd-detail-label">商品について</div>
      <div class="pd-detail-text">{{ product.description }}</div>
    {%- endif -%}
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
(function () {
  var productData = {{ product | json }};
  var variantIdInput = document.getElementById('pd-variant-id');
  var priceEl = document.getElementById('pd-price');
  var addBtn = document.querySelector('.pd-add-btn');
  var mainImg = document.getElementById('pd-main-img-el');
  var selectedOptions = {};

  productData.options.forEach(function (opt, i) {
    selectedOptions[i] = productData.selected_or_first_available_variant.options[i];
  });

  document.querySelectorAll('.pd-thumb').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      document.querySelectorAll('.pd-thumb').forEach(function (t) { t.classList.remove('active'); });
      this.classList.add('active');
      if (mainImg) mainImg.src = this.dataset.img;
    });
  });

  document.querySelectorAll('.pd-color-swatch').forEach(function (swatch) {
    swatch.addEventListener('click', function () {
      var idx = parseInt(this.parentElement.dataset.optionIndex, 10);
      this.parentElement.querySelectorAll('.pd-color-swatch').forEach(function (s) { s.classList.remove('active'); });
      this.classList.add('active');
      selectedOptions[idx] = this.dataset.value;
      updateVariant();
    });
  });

  document.querySelectorAll('.pd-size-pill').forEach(function (pill) {
    pill.addEventListener('click', function () {
      var idx = parseInt(this.parentElement.dataset.optionIndex, 10);
      this.parentElement.querySelectorAll('.pd-size-pill').forEach(function (p) { p.classList.remove('active'); });
      this.classList.add('active');
      selectedOptions[idx] = this.dataset.value;
      updateVariant();
    });
  });

  function updateVariant() {
    var optionValues = productData.options.map(function (_, i) { return selectedOptions[i]; });
    var matched = productData.variants.find(function (v) {
      return v.options.every(function (opt, i) { return opt === optionValues[i]; });
    });
    if (!matched) return;

    variantIdInput.value = matched.id;
    priceEl.textContent = (window.Shopify && Shopify.formatMoney)
      ? Shopify.formatMoney(matched.price)
      : ('¥' + (matched.price / 100).toLocaleString());
    if (matched.available) {
      addBtn.disabled = false;
      addBtn.textContent = 'カートに追加';
    } else {
      addBtn.disabled = true;
      addBtn.textContent = 'SOLD OUT';
    }
    if (matched.featured_image && mainImg) {
      mainImg.src = matched.featured_image.src;
    }
  }

  var copyBtn = document.getElementById('share-copy');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      var url = this.dataset.shareUrl;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function () {
          if (window.showToast) window.showToast('リンクをコピーしました');
        });
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Product Main",
  "tag": "section"
}
{% endschema %}
