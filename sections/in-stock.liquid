<div class="sec-head">
  <div>
    <span class="sec-head__title">In Stock</span>
    <span class="sec-head__sub">販売中のアイテム</span>
  </div>
  {%- if section.settings.collection -%}
    <a href="{{ section.settings.collection.url }}" class="sec-head__viewall">すべて見る &rarr;</a>
  {%- endif -%}
</div>

<div class="product-grid">
  {%- if section.settings.collection -%}
    {%- for product in section.settings.collection.products limit: section.settings.limit -%}
      {%- assign badge_type = '' -%}
      {%- if product.tags contains 'new' -%}{%- assign badge_type = 'new' -%}{%- endif -%}
      {%- if product.tags contains 'limited' -%}{%- assign badge_type = 'limited' -%}{%- endif -%}
      {% render 'product-card', product: product, badge: badge_type %}
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "In Stock",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Max products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "In Stock"
    }
  ]
}
{% endschema %}
