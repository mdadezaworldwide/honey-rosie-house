<div class="sec-head">
  <div>
    <span class="sec-head__title">New Arrival</span>
    <span class="sec-head__sub">新着アイテム</span>
  </div>
  {%- if section.settings.collection -%}
    <a href="{{ section.settings.collection.url }}" class="sec-head__viewall">すべて見る &rarr;</a>
  {%- endif -%}
</div>

<div class="product-scroll">
  <div class="product-row">
    {%- if section.settings.collection -%}
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {%- assign badge_type = '' -%}
        {%- if product.tags contains 'new' -%}{%- assign badge_type = 'new' -%}{%- endif -%}
        {%- if product.tags contains 'limited' -%}{%- assign badge_type = 'limited' -%}{%- endif -%}
        {% render 'product-card', product: product, badge: badge_type, featured: forloop.first %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "New Arrival",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Max products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "New Arrival"
    }
  ]
}
{% endschema %}
