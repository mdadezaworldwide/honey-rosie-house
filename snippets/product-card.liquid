{%- comment -%}
  Usage: {% render 'product-card', product: product, featured: true, badge: 'new' %}
  featured: boolean (larger card in horizontal rows)
  badge: 'new' | 'limited' | blank (auto-overridden to 'soldout' when unavailable)
{%- endcomment -%}

{%- assign card_class = 'p-card' -%}
{%- if featured -%}{%- assign card_class = card_class | append: ' p-card--featured' -%}{%- endif -%}
{%- unless product.available -%}{%- assign card_class = card_class | append: ' p-card--soldout' -%}{%- endunless -%}

<a href="{{ product.url }}" class="{{ card_class }}">
  <div class="p-card__img">
    {%- if product.featured_image -%}
      <img
        class="p-card-img-fill"
        src="{{ product.featured_image | image_url: width: 500 }}"
        alt="{{ product.featured_image.alt | default: product.title }}"
        loading="lazy"
        width="250"
        height="330"
      >
    {%- endif -%}

    {%- unless product.available -%}
      <span class="p-card__badge p-card__badge--soldout">SOLD OUT</span>
    {%- else -%}
      {%- if badge == 'new' -%}
        <span class="p-card__badge p-card__badge--new">NEW</span>
      {%- elsif badge == 'limited' -%}
        <span class="p-card__badge p-card__badge--limited">LIMITED</span>
      {%- endif -%}
    {%- endunless -%}

    {%- if product.available -%}
      <div class="p-card__quick"><span>詳しく見る</span></div>
    {%- else -%}
      <div class="p-card__notify"><span>再入荷通知</span></div>
    {%- endif -%}
  </div>
  <div class="p-card__body">
    <div class="p-card__name">{{ product.title }}</div>
    {%- if product.variants.size > 1 and product.options.size > 0 -%}
      <div class="p-card__variant">
        {%- for option in product.options_with_values -%}
          {{ option.values.size }} {{ option.name | downcase }}{% unless forloop.last %} / {% endunless %}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="p-card__price"{% unless product.available %} style="opacity:.45; text-decoration:line-through;"{% endunless %}>
      {{ product.price | money_without_trailing_zeros }}
      <span class="p-card__tax">税込</span>
    </div>
  </div>
</a>
