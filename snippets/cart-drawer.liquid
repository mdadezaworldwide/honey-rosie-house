<div class="cart-panel" id="cartPanel">
  <div class="cart-panel__backdrop" onclick="closeCart()"></div>
  <div class="cart-panel__inner">
    <div class="cart-panel__head">
      <span class="cart-panel__title">MY BAG</span>
      <button class="cart-panel__close" onclick="closeCart()" type="button" aria-label="Close cart">×</button>
    </div>
    <div class="cart-panel__body" id="cartPanelBody">
      {%- if cart.item_count == 0 -%}
        <div class="cart-panel__empty">カートは空です</div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item" data-key="{{ item.key }}">
            <img class="cart-item__img" src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title }}">
            <div class="cart-item__info">
              <div>
                <div class="cart-item__name">{{ item.product.title }}</div>
                <div class="cart-item__meta">
                  {%- if item.variant.title != 'Default Title' -%}{{ item.variant.title }}{%- endif -%}
                  {%- if item.quantity > 1 %} × {{ item.quantity }}{%- endif -%}
                </div>
              </div>
              <div class="cart-item__price">{{ item.final_line_price | money_without_trailing_zeros }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="cart-panel__foot">
      <div class="cart-panel__subtotal">
        <span>小計</span>
        <span id="cartSubtotal">{{ cart.total_price | money_without_trailing_zeros }}</span>
      </div>
      <form action="/cart" method="post">
        <button type="submit" name="checkout" class="cart-panel__checkout" {% if cart.item_count == 0 %}disabled{% endif %}>レジに進む</button>
      </form>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>
